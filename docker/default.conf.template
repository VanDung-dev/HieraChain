
upstream hierachain_nodes {
    server node1:2661;
    server node2:2661;
    server node3:2661;
    server node4:2661;
}

server {
    listen 80;

    # Randomized stealth explorer path
    location /${EXPLORER_TOKEN}/explorer {
        proxy_pass http://hierachain_nodes/api/v1/explorer/dashboard;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Randomized status page
    location /${EXPLORER_TOKEN}/status {
        default_type text/html;
        return 200 '
        <!DOCTYPE html>
        <html>
        <head>
            <title>HieraChain Status</title>
            <style>
                body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 800px; margin: 40px auto; padding: 20px; line-height: 1.6; background: #ffffff; color: #333; }
                .card { border: 1px solid #eaeaea; padding: 24px; border-radius: 12px; margin-bottom: 20px; background: #fafafa; }
                h1 { font-size: 24px; font-weight: 600; margin-top: 0; color: #000; border-bottom: 1px solid #eee; padding-bottom: 12px; }
                h2 { font-size: 18px; font-weight: 600; }
                .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
                .status-up { background: #e6ffed; color: #22863a; border: 1px solid #bef5cb; }
                .node-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
                .node-item { padding: 12px; border: 1px solid #eee; border-radius: 8px; background: #fff; font-size: 14px; }
                .footer { font-size: 12px; color: #888; margin-top: 40px; text-align: center; }
            </style>
        </head>
        <body>
            <div class="card">
                <h1>HieraChain Enterprise Test Server</h1>
                <p>Global Status: <span class="status-badge status-up">System Online</span></p>
                <p>Architecture: <code style="background:#eee;padding:2px 6px;border-radius:4px;">Isolated Plugin Layer</code></p>
            </div>
            <div class="card">
                <h2>Cluster Topology</h2>
                <div class="node-list">
                    <div class="node-item"><b>Node 1</b><br>172.28.0.10:2661<br><span style="color:#22863a">● Active</span></div>
                    <div class="node-item"><b>Node 2</b><br>172.28.0.11:2661<br><span style="color:#22863a">● Active</span></div>
                    <div class="node-item"><b>Node 3</b><br>172.28.0.12:2661<br><span style="color:#22863a">● Active</span></div>
                    <div class="node-item"><b>Node 4</b><br>172.28.0.13:2661<br><span style="color:#22863a">● Active</span></div>
                </div>
            </div>
            <div class="footer">
                Security Policy: Session-Based Dynamic Token Access Control (SB-DTAC) Active
            </div>
        </body>
        </html>';
    }

    # General API proxy for ledger operations
    location /api/ {
        proxy_pass http://hierachain_nodes;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Increase timeouts for heavy stress loads
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Root redirect to prevent discovery
    location / {
        return 403 "Forbidden: HieraChain Stealth Mode Active\n";
    }

    location /gateway-health {
        access_log off;
        return 200 '{"status": "gateway_up"}';
        add_header Content-Type application/json;
    }
}
