
# Define the HieraChain Node Cluster for Load Balancing
upstream hierachain_nodes {
    server node1:2661 max_fails=3 fail_timeout=10s;
    server node2:2661 max_fails=3 fail_timeout=10s;
    server node3:2661 max_fails=3 fail_timeout=10s;
    server node4:2661 max_fails=3 fail_timeout=10s;
    
    # Use keepalive connections for better WAN performance
    keepalive 32;
}

server {
    listen 80;
    server_name localhost;

    # Docker DNS resolver
    resolver 127.0.0.11 valid=30s;
    
    # Increase timeouts for WAN simulations
    proxy_connect_timeout 15s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Performance Tuning for high-throughput stress tests
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Standard health check for internal monitors
    location /gateway-health {
        access_log off;
        return 200 '{"status": "gateway_up"}';
        add_header Content-Type application/json;
    }

    # Stealth Dashboard & Status (Token Protected)
    location ~ ^/${EXPLORER_TOKEN}/(?<page>status|explorer)$ {
        alias /usr/share/nginx/html/;
        try_files $page.html =404;
    }

    # API Pass-through with Load Balancing and Automatic Retry
    location /api/ {
        proxy_pass http://hierachain_nodes;
        
        # Security headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Enable HTTP/1.1 and keepalive
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Automatic Retry on node failure
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 10s;
    }

    # WebSocket Proxy for real-time event streaming
    location /ws {
        proxy_pass http://hierachain_nodes;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Extended timeouts for long-lived WS connections
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Node Discovery Endpoint (Returns the list of nodes from env var)
    location ~ ^/${EXPLORER_TOKEN}/nodes$ {
        add_header Content-Type application/json;
        return 200 "{\"nodes\": \"${HRC_NODES}\"}";
    }

    # Dynamic Diagnostic Bridge
    # Proxies to any node name provided in the URL
    location ~ ^/${EXPLORER_TOKEN}/diag/(?<target_node>[^/]+) {
        # Internal security: Only allow proxying to nodes on the internal network
        proxy_pass http://$target_node:2661/api/v1/health;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        
        # Retry logic for nodes that are still starting up
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_connect_timeout 2s;
        
        proxy_intercept_errors on;
        error_page 502 503 504 = @node_error;
    }

    # Error Handler for Diagnostic Bridge
    location @node_error {
        add_header Content-Type application/json;
        if ($status = 504) {
            return 200 '{"status": "timeout"}';
        }
        return 200 '{"status": "down"}';
    }

    # Default Block for root and everything else (The Stealth Layer)
    location / {
        return 403 'Forbidden: HieraChain Stealth Mode Active. Use authorized path.';
    }
}
