
# HieraChain Podman-specific Gateway Configuration
upstream hierachain_nodes {
    server node1:2661 max_fails=3 fail_timeout=10s;
    server node2:2661 max_fails=3 fail_timeout=10s;
    server node3:2661 max_fails=3 fail_timeout=10s;
    server node4:2661 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 8080; # Sử dụng cổng > 1024 cho Rootless Podman
    server_name localhost;

    # Podman uses aardvark-dns. On this network, it's at the .1 address.
    # Nginx requires a resolver when using variables in proxy_pass.
    resolver 172.28.0.1;

    proxy_connect_timeout 15s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location /gateway-health {
        access_log off;
        return 200 '{"status": "gateway_up", "engine": "podman"}';
        add_header Content-Type application/json;
    }

    location ~ ^/${EXPLORER_TOKEN}/(?<page>status|explorer)$ {
        alias /usr/share/nginx/html/;
        try_files $page.html =404;
    }

    # Node Discovery Endpoint (Returns the list of nodes from env var)
    location ~ ^/${EXPLORER_TOKEN}/nodes$ {
        add_header Content-Type application/json;
        return 200 "{\"nodes\": \"${HRC_NODES}\"}";
    }

    # Dynamic Diagnostic Bridge
    location ~ ^/${EXPLORER_TOKEN}/diag/(?<target_node>[^/]+) {
        proxy_pass http://$target_node:2661/api/v1/health;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 2s;
        
        proxy_intercept_errors on;
        error_page 502 503 504 = @node_error;
    }

    # Error Handler for Diagnostic Bridge
    location @node_error {
        add_header Content-Type application/json;
        return 200 '{"status": "down"}';
    }

    location /api/ {
        proxy_pass http://hierachain_nodes;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    location / {
        return 403 '{"error": "Forbidden", "message": "HieraChain Podman Gateway Active"}';
        add_header Content-Type application/json;
    }
}

