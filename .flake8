[flake8]
max-line-length = 120
ignore = E203,E266,E501,W503,W291,W293,W301,W292,W504,E128,E226,E231,E251,E261,E265,E301,E302,E305,E402,E701,E702,E712,E714,E731,E303,E306,E131,E202,E225,E123,F401,F541,F824,F841,F601,W391,E115,E126
exclude = .git,__pycache__,.pytest_cache,.mypy_cache,.tox,.venv,build,dist,*.egg-info,docs
per-file-ignores = __init__.py:F401
